{
  "name": "biostasis",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "Concise Software",
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "build-ci": "tsc -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "ts-node -r tsconfig-paths/register src/main.ts",
    "start:dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node dist/main.js\"",
    "start:debug": "tsc-watch -p tsconfig.build.json --onSuccess \"node --inspect-brk dist/main.js\"",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:integration": "jest --config ./test/jest-integration.json --runInBand",
    "check:dependencies": "depcheck",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js --config config/typeorm.js",
    "typeorm:create": "npm run typeorm migration:create -- -n",
    "typeorm:run": "npm run typeorm migration:run"
  },
  "resolutions": {
    "node-mailjet/**/pac-resolver": "5.0.0"
  },
  "dependencies": {
    "@hapi/joi-date": "^2.0.1",
    "@nestjs/bull": "^0.4.1",
    "@nestjs/common": "^8.0.6",
    "@nestjs/core": "^8.0.6",
    "@nestjs/passport": "^8.0.1",
    "@nestjs/platform-express": "^8.0.6",
    "@nestjs/swagger": "5.0.9",
    "@nestjs/throttler": "^2.0.0",
    "@nestjs/typeorm": "8.0.2",
    "aws-sdk": "^2.965.0",
    "bull": "^3.28.1",
    "class-transformer": "^0.4.0",
    "config": "^3.3.6",
    "dotenv": "^10.0.0",
    "firebase-admin": "^9.11.0",
    "fs": "^0.0.1-security",
    "google-libphonenumber": "^3.2.22",
    "helmet": "^4.6.0",
    "ioredis-mock": "^5.6.0",
    "joi": "^17.4.2",
    "jsonwebtoken": "^8.5.1",
    "jwk-to-pem": "^2.0.5",
    "moment": "^2.29.1",
    "mysql": "^2.18.1",
    "node-mailjet": "^3.3.4",
    "passport": "^0.4.1",
    "passport-jwt": "^4.0.0",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^3.0.2",
    "rxjs": "^7.3.0",
    "swagger-ui-express": "^4.1.6",
    "twilio": "^3.68.0",
    "typeorm": "0.2.36"
  },
  "devDependencies": {
    "@nestjs/cli": "^8.1.1",
    "@nestjs/schematics": "^8.0.2",
    "@nestjs/testing": "^8.0.6",
    "@types/bull": "^3.15.3",
    "@types/express": "^4.17.13",
    "@types/faker": "^5.5.7",
    "@types/google-libphonenumber": "^7.4.21",
    "@types/jest": "^27.0.0",
    "@types/joi": "^17.2.3",
    "@types/node": "^16.4.13",
    "@types/node-mailjet": "^3.3.7",
    "@types/supertest": "^2.0.11",
    "@types/twilio": "^3.19.3",
    "@typescript-eslint/eslint-plugin": "^4.29.1",
    "@typescript-eslint/parser": "^4.29.1",
    "depcheck": "^1.4.2",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^3.4.0",
    "faker": "^5.5.3",
    "jest": "^27.0.6",
    "prettier": "^2.3.2",
    "supertest": "^6.1.4",
    "ts-jest": "^27.0.4",
    "ts-loader": "^9.2.5",
    "ts-node": "^10.2.0",
    "tsc-watch": "^4.4.0",
    "tsconfig-paths": "^3.10.1",
    "typescript": "^4.3.5"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
